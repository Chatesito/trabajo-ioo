# ======================================
# Configuración de la app (Django)
# ======================================
SECRET_KEY=django-insecure-cambiame-en-prod-xxxxxxxxxxxxxxxxxxxxxx
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ======================================
# Configuración de PostgreSQL
# ======================================
POSTGRES_DB=clinica
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=clinica_pass

# URL que Django lee vía django-environ. El host "db" es el nombre del
# servicio en compose.yml; NO lo cambies salvo que renombres el servicio.
DATABASE_URL=postgres://clinica_user:clinica_pass@db:5432/clinica

# ======================================
# Superusuario de Django (creado automáticamente)
# Dejalo vacío si no querés que se cree
# ======================================
DJANGO_SUPERUSER_USERNAME=Leon
DJANGO_SUPERUSER_EMAIL=leon@ioo.local
DJANGO_SUPERUSER_PASSWORD=Leon123@
